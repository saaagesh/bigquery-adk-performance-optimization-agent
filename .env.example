# BigQuery Performance Optimization Environment Configuration
# Copy this file to .env and fill in your values

# Backend Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=true
FLASK_ENV=development

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# BigQuery Configuration
BIGQUERY_REGION=us
BIGQUERY_LOCATION=US
DEFAULT_TIME_RANGE_HOURS=24
MAX_QUERY_RESULTS=20
QUERY_TIMEOUT_SECONDS=300

# Performance Configuration
SLOT_USAGE_MAX=2000
JOB_CONCURRENCY_MAX=100
CACHE_TTL_SECONDS=300

# Frontend Configuration (prefix with VITE_ for Vite to expose to browser)
VITE_REACT_APP_API_BASE_URL=http://localhost:8080/api
VITE_REACT_APP_DEFAULT_TIME_RANGE=24h
VITE_REACT_APP_REFRESH_INTERVAL_MS=30000
VITE_REACT_APP_DEFAULT_PROJECT=your-project-id-here
VITE_REACT_APP_DEFAULT_REGION=us